# Salin file ini jadi .env.local lalu isi dengan nilai asli dari dashboard Supabase & Midtrans.
# JANGAN commit .env.local ke GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_key
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key

MIDTRANS_SERVER_KEY=isi_dengan_server_key_sandbox
MIDTRANS_CLIENT_KEY=isi_dengan_client_key_sandbox
MIDTRANS_IS_PRODUCTION=false
